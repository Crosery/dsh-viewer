{
  "name": "@crosery/dsh-viewer",
  "version": "0.1.0",
  "description": "Renders images, video, audio, PDF and Office documents inline in the dsh web UI through a display_file tool, streaming bytes over a signed HTTP route with range support.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "viewer",
    "preview",
    "image",
    "video",
    "audio",
    "pdf",
    "office",
    "docx",
    "xlsx",
    "pptx"
  ],
  "homepage": "https://github.com/Crosery/dsh-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crosery/dsh-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/Crosery/dsh-viewer/issues"
  },
  "author": "Crosery",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "screenshots.json",
    "assets/**",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.2.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
